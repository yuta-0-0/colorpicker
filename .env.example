# ── Supabase ──────────────────────────────────────────────
# Supabase プロジェクトの URL（Project Settings > API）
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public キー（Project Settings > API > anon key）
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── 開発用フラグ ───────────────────────────────────────────
# true にすると Supabase 認証をスキップしてローカル開発できる（本番では必ず false）
VITE_DEV_BYPASS_AUTH=false
